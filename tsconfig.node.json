{
  "compilerOptions": {
    // 1. TS 编译缓存文件路径（加速编译，不用管）
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    // 2. 编译目标 JS 版本：ES2023（现代 Node 支持）
    "target": "es2023",

    // 3. 项目可用的内置类型库：只包含 ES2023（Node 环境不需要 DOM）
    "lib": ["ES2023"],

    // 4. 使用最新的 ES 模块语法（import/export）
    "module": "esnext",

    // 5. 注入 Node.js 类型定义（让 TS 认识 process、path 等）
    "types": ["node"],

    // 6. 跳过第三方库的类型检查（大幅提速，避免报错）
    "skipLibCheck": true,

    /* 打包工具模式（Vite 使用，专门给配置文件） */
    // 7. 使用 bundler 模块解析策略（Vite/Rollup/Webpack 专用）
    "moduleResolution": "bundler",

    // 8. 允许导入 .ts 后缀的文件（Vite 配置需要）
    "allowImportingTsExtensions": true,

    // 9. 严格保留模块语法（不转译 import/export，必须用 ESM）
    "verbatimModuleSyntax": true,

    // 10. 强制所有文件都是模块（必须有 import/export，避免全局变量冲突）
    "moduleDetection": "force",

    // 11. 不生成编译后的 JS 文件（只做类型检查，因为 Vite 会处理）
    "noEmit": true,

    /* 代码检查规则（更严格） */
    // 12. 不允许有未使用的局部变量（报错）
    "noUnusedLocals": true,

    // 13. 不允许有未使用的函数参数（报错）
    "noUnusedParameters": true,

    // 14. 只允许纯类型擦除语法（严格 TS 模式）
    "erasableSyntaxOnly": true,

    // 15. switch 必须写 break，不允许穿透
    "noFallthroughCasesInSwitch": true
  },

  // 只对 vite.config.ts 应用这份严格配置
  "include": ["vite.config.ts"]
}
